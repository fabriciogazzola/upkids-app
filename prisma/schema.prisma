generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id    String @id @default(cuid())
  name  String
  users User[]
  tasks Task[]
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          String   @default("FILHO") // PAI ou FILHO
  familyId      String
  family        Family   @relation(fields: [familyId], references: [id])
  
  // Alterado para permitir que um usuário tenha muitas tarefas
  tasksAssigned Task[]   @relation("TaskToUser")
  
  // Execuções específicas deste usuário (Importante para o Placar)
  executions    TaskExecution[]
}

model Task {
  id          String   @id @default(cuid())
  description String
  points      Int
  diasSemana  String?  // Ex: "1,2,3" (Seg, Ter, Qua)
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id])
  
  // Alterado para permitir múltiplos heróis na mesma tarefa
  assignedTo  User[]   @relation("TaskToUser")
  
  executions  TaskExecution[]
  createdAt   DateTime @default(now())
}

model TaskExecution {
  id        String   @id @default(cuid())
  taskId    String
  userId    String   // Adicionado: Quem completou a tarefa
  date      DateTime // Data da conclusão (meio-dia T12:00:00Z)
  
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // O check é único por tarefa, usuário e dia
  @@unique([taskId, userId, date])
}